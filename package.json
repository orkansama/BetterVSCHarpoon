{
  "name": "bettervscharpoon",
  "displayName": "BetterVSCHarpoon",
  "description": "Harpoon for VSC, made txt simple!",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bettervscharpoon.open_harpoon_list",
        "title": "bettervscharpoon.open_harpoon_list"
      },
      {
        "command": "bettervscharpoon.add_to_harpoon_list",
        "title": "bettervscharpoon.add_to_harpoon_list"
      },
      {
        "command": "bettervscharpoon.navigate_1",
        "title": "bettervscharpoon.navigate_1"
      },
      {
        "command": "bettervscharpoon.navigate_2",
        "title": "bettervscharpoon.navigate_2"
      },
      {
        "command": "bettervscharpoon.navigate_3",
        "title": "bettervscharpoon.navigate_3"
      },
      {
        "command": "bettervscharpoon.navigate_4",
        "title": "bettervscharpoon.navigate_4"
      },
      {
        "command": "bettervscharpoon.navigate_5",
        "title": "bettervscharpoon.navigate_5"
      },
      {
        "command": "bettervscharpoon.navigate_6",
        "title": "bettervscharpoon.navigate_6"
      },
      {
        "command": "bettervscharpoon.navigate_7",
        "title": "bettervscharpoon.navigate_7"
      },
      {
        "command": "bettervscharpoon.navigate_8",
        "title": "bettervscharpoon.navigate_8"
      },
      {
        "command": "bettervscharpoon.navigate_9",
        "title": "bettervscharpoon.navigate_9"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "semantic-release": "^24.2.9",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkansama/BetterVSCHarpoon"
  },
  "publisher": "OrkanGoekcen",
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^9.3.1"
  }
}
